# TrialPulse Environment Variables
# Copy this file to .env and fill in your keys

# Gemini API (optional — mock mode used when missing)
GEMINI_API_KEY=

# ElevenLabs API (optional — mock mode used when missing)
ELEVENLABS_API_KEY=

# Backend
API_PORT=4000
NODE_ENV=development

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:4000/api
