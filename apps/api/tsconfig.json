{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "moduleResolution": "node",
    "baseUrl": ".",
    "paths": {
      "@trialpulse/types": ["../../packages/types/src"],
      "@trialpulse/config": ["../../packages/config/src"]
    }
  },
  "include": ["src/**/*"]
}
